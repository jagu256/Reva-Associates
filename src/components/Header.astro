---
import { nav, site } from '../data/site';

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="wrap header-row">
    <a class="wordmark" href="/" aria-label={site.name}>
      <img src="/logo-mark.png" alt="" width="70" height="48" />
      <span>{site.shortName}<small>Limited</small></span>
    </a>

    <nav class="nav-desktop" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>

    <details class="nav-mobile">
      <summary aria-label="Menu">Menu</summary>
      <nav aria-label="Mobile">
        {nav.map((item) => (
          <a href={item.href} aria-current={item.href === current ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
