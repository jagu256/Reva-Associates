---
import Base from '../layouts/Base.astro';
import { isTodo, serviceGroups, site } from '../data/site';

const { email } = site.contact;
---

<Base title="Services" description="URA customs and tax audits, tax, accounting, payroll and company services in Uganda.">
  <section class="page-intro">
    <div class="wrap">
      <p class="eyebrow">Services</p>
      <h1>How we can help</h1>
      <p class="lead">URA audits and disputes, tax, accounting and company support, in one place.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {serviceGroups.map((group) => (
        <div class="service-group">
          <h2>{group.title}</h2>
          <ul class="service-list">
            {group.items.map((item) => (
              <li>
                <h3>{item.name}</h3>
                <p>{item.text}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="band">
    <div class="wrap band-row">
      <div>
        <h2>Need a quote?</h2>
        <p>Tell us what you need and we'll send you a quote.</p>
      </div>
      <div class="button-row">
        <a class="button" href="/contact/">Request a quote</a>
        {!isTodo(email) && <a class="button button-outline" href={`mailto:${email}?subject=Quote%20request`}>Email us</a>}
      </div>
    </div>
  </section>
</Base>
