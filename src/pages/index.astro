---
import Base from '../layouts/Base.astro';
import Field from '../components/Field.astro';
import { clientTypes, featuredServices, site, strengths } from '../data/site';
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">Accounting, tax &amp; audit in Uganda</p>
        <h1>Clear books. Timely filings. Advice you can act on.</h1>
        <p class="lead"><Field v={site.summary} /></p>
        <div class="button-row">
          <a class="button" href="/contact/">Talk to us</a>
          <a class="button button-quiet" href="/services/">See our services</a>
        </div>
      </div>

      <aside class="ledger" aria-label="Main services">
        <p class="ledger-title">What we do</p>
        <ol>
          {featuredServices.map((service) => <li>{service}</li>)}
        </ol>
        <p class="ledger-foot"><Field v="[TODO: confirm these four top services]" /></p>
      </aside>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why clients choose us</p>
        <h2>Straightforward support, start to finish</h2>
      </div>
      <div class="cols">
        {strengths.map((item) => (
          <div class="col">
            <h3><Field v={item.title} /></h3>
            <p><Field v={item.text} /></p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Who we work with</p>
        <h2>Clients we serve</h2>
      </div>
      <ul class="tag-list">
        {clientTypes.map((type) => <li><Field v={type} /></li>)}
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-row">
      <div>
        <h2>Need help with your books or taxes?</h2>
        <p>Tell us what you need and we'll get back to you.</p>
      </div>
      <a class="button" href="/contact/">Contact us</a>
    </div>
  </section>
</Base>
