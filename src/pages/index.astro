---
import Base from '../layouts/Base.astro';
import { clients, clientTypes, featuredServices, site, strengths } from '../data/site';

const stats = [
  [site.experience, 'of accounting and tax experience'],
  [site.clients, 'clients served'],
  [site.founded, 'year founded'],
];
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">{site.slogan}</p>
        <h1>Clear books. Timely filings. Support when URA calls.</h1>
        <p class="lead">{site.summary}</p>
        <div class="button-row">
          <a class="button" href="/contact/">Talk to us</a>
          <a class="button button-quiet" href="/services/">See our services</a>
        </div>
      </div>

      <aside class="ledger" aria-label="Main services">
        <p class="ledger-title">Main services</p>
        <ol>
          {featuredServices.map((service) => <li>{service}</li>)}
        </ol>
      </aside>
    </div>
  </section>

  <section class="stats" aria-label="The firm in numbers">
    <dl class="wrap stats-row">
      {stats.map(([value, label]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="section section-alt">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Why clients choose us</p>
        <h2>Experience you can rely on</h2>
      </div>
      <div class="cols">
        {strengths.map((item) => (
          <div class="col">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split-even">
      <div>
        <div class="section-head">
          <p class="eyebrow">Who we work with</p>
          <h2>Industries we serve</h2>
        </div>
        <ul class="plain-list">
          {clientTypes.map((type) => <li>{type}</li>)}
        </ul>
      </div>
      <div>
        <div class="section-head">
          <p class="eyebrow">Our clients</p>
          <h2>Businesses we've worked with</h2>
        </div>
        <ul class="plain-list">
          {clients.map((client) => <li>{client}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap band-row">
      <div>
        <h2>Need help with your books or a URA matter?</h2>
        <p>Tell us what you need and we'll get back to you.</p>
      </div>
      <a class="button" href="/contact/">Contact us</a>
    </div>
  </section>
</Base>
