---
import Base from '../layouts/Base.astro';
import { site, team } from '../data/site';
---

<Base title="Team" description={`Meet the team at ${site.name}.`}>
  <section class="page-intro">
    <div class="wrap">
      <p class="eyebrow">Team</p>
      <h1>Who you'll work with</h1>
    </div>
  </section>

  <section class="section">
    <div class="wrap team-grid">
      {team.map((person) => (
        <article class="person">
          <h2>{person.name}</h2>
          <p class="person-role">{person.title} · {person.quals}</p>
          <p>{person.bio}</p>
        </article>
      ))}
    </div>
  </section>
</Base>
